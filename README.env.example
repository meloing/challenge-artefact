# =============================================================================
# WABA Group Data Platform - Environment Variables Template
# Copy this file to .env before starting the services
# Note: Never commit secrets or credentials with real values to git!
# =============================================================================

# --- General Platform Settings ---
ENVIRONMENT=development
WABA_CLUSTER_REGION=africa-west1

# --- MinIO & S3 Lakehouse Object Storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
BUCKET_RAW=raw-landing
BUCKET_LAKEHOUSE=lakehouse
BUCKET_ARCHIVE=archive

# --- Apache Iceberg REST Catalog ---
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_CATALOG_NAME=waba
ICEBERG_WAREHOUSE=s3a://lakehouse/

# --- Trino Query Engine ---
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=trino
TRINO_URI=trino://trino@localhost:8080/iceberg/gold

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_ID=1

# --- Apache NiFi ---
NIFI_WEB_HTTP_PORT=8090

# --- Apache Airflow ---
AIRFLOW_UID=50000
AIRFLOW_DATABASE_USER=airflow
AIRFLOW_DATABASE_PASSWORD=airflow_secure_password
AIRFLOW_DATABASE_NAME=airflow
AIRFLOW_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/WEBHOOK/URL

# --- Apache Superset ---
SUPERSET_SECRET_KEY=WABA_SUPERSET_SECRET_KEY_SUPER_SECURE_98234
SUPERSET_PORT=8088

# --- Keycloak SSO ---
KEYCLOAK_BASE_URL=http://localhost:8080/realms/waba/protocol/openid-connect/
KEYCLOAK_SUPERSET_CLIENT_ID=waba-superset
KEYCLOAK_SUPERSET_CLIENT_SECRET=superset-sso-secret-waba

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
